{
  "schemaVersion": 1,
  "description": "SeekVec 最终主矩阵（2026-10-27 优化后）：默认 batch=32 / WASM threads=8；ABBA × 5 正式轮 + 1 预热。官方 3.2 表：量化前基线 FP32+WASM；INT8(q8)+WASM；FP16+WebGPU；另含冷启动。消融实验（batch/threads/refresh 与增量导入）见 docs/性能优化分析.md 与 docs/benchmarks/optimization-2026-10-27/。",
  "abba": true,
  "runs": 5,
  "warmup": 1,
  "timeoutMs": 300000,
  "corpus": "data/perf/corpus",
  "queries": "data/perf/queries.txt",
  "configs": [
    { "id": "fp32-wasm", "backend": "wasm", "dtype": "fp32", "batch": 32, "threads": 8, "refresh": "last", "cold": false },
    { "id": "q8-wasm", "backend": "wasm", "dtype": "q8", "batch": 32, "threads": 8, "refresh": "last", "cold": false },
    { "id": "fp16-webgpu", "backend": "webgpu", "dtype": "fp16", "batch": 32, "refresh": "last", "cold": false },
    { "id": "cold-q8-wasm", "backend": "wasm", "dtype": "q8", "batch": 32, "threads": 8, "refresh": "last", "cold": true }
  ]
}
