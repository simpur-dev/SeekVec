# SeekVec 环境变量示例（根目录）
#
# 复制为根目录 `.env`（已被 .gitignore 忽略）：
#   cp .env.example .env          # Linux/macOS
#   Copy-Item .env.example .env   # PowerShell
#
# 作用：
#   1) docker compose 自动读取根目录 .env 做变量替换（SEEKDB_PORT / SEEKDB_IMAGE）；
#   2) `npm run dev:docker` 解析本文件并把 SEEKDB_* 注入 `npm run dev` 的子进程。
# 优先级：已存在的系统环境变量 > .env（临时覆盖示例：
#   $env:SEEKDB_PORT="2883"; npm run dev:docker  # Windows PowerShell）。
#
# 前端（Vite）变量不放这里，见 web/.env.local.example。

# ---- seekdb 连接（server 模式；默认值与 server/src/config.ts 一致）----
SEEKDB_HOST=127.0.0.1
# Docker Compose 把宿主机 2882 映射到容器内 2881；非 Docker 部署常见为 2881
SEEKDB_PORT=2882
SEEKDB_USER=root
# 本机开发默认空密码；远程/生产环境务必修改
SEEKDB_PASSWORD=
SEEKDB_DATABASE=seekvec
# 单条 SQL 查询超时（毫秒），传入 seekdb-js 的 queryTimeout
SEEKDB_QUERY_TIMEOUT_MS=30000
# 嵌入式模式（仅 Linux/macOS 可用，Windows 官方不支持）：
# 设置后忽略 SEEKDB_HOST/PORT，直接使用本地数据目录
# SEEKDB_PATH=

# ---- server ----
PORT=3001
# CORS 允许来源，逗号分隔（web dev server）
CORS_ORIGINS=http://localhost:5173

# ---- Docker / seekdb 镜像 ----
# 默认 quay.io/oceanbase/seekdb:latest（实测 seekdb 1.4.0；digest 见 docker-compose.yml 注释）
# 需要完全可复现时固定 digest：
# SEEKDB_IMAGE=quay.io/oceanbase/seekdb@sha256:4db4961869d554313520d6081fca29265ba6da6db7313311bd8acbed771a956b
SEEKDB_IMAGE=quay.io/oceanbase/seekdb:latest
# compose 容器名（一般不用改）
SEEKDB_CONTAINER_NAME=seekvec-seekdb

# ---- 本机运行资产目录（模型缓存等；约定放 D 盘/工作区，避免写系统盘）----
# Node 端脚本（scripts/bench.ts、fetch-models.mjs 等）的模型缓存目录
SEEKVEC_CACHE_DIR=./scripts/.cache

# ---- 模型下载源 ----
# 官方 https://huggingface.co/ ；国内网络可用镜像（例：https://hf-mirror.com/）
HF_ENDPOINT=https://huggingface.co/

# ---- 浏览器基准测试（scripts/bench-browser.mjs / bench-matrix.mjs）----
# 留空则自动探测 Chrome/Edge/Playwright 缓存；也可显式指定可执行文件路径
# Windows 例：C:\Program Files\Google\Chrome\Application\chrome.exe
# Linux/macOS 例：/usr/bin/google-chrome
BROWSER_PATH=
# 基准测试页面地址；若 dev server 不在 5173，改这里或传 --base-url
SEEKVEC_BASE_URL=http://localhost:5173
