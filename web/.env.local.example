# SeekVec Web（Vite）环境变量示例
#
# 推荐复制为 web/.env.local（已被 gitignore 忽略）：
#   cp web/.env.local.example web/.env.local          # Linux/macOS
#   Copy-Item web/.env.local.example web/.env.local   # PowerShell
#
# 本示例默认使用“本地模型 + 同源 ORT 资源”，启动前先执行：
#   npm run prepare:assets
# 若希望 embedding 模型直接从 Hugging Face 在线加载，把 VITE_LOCAL_MODELS 改为 0（或删除该行）。
# 注意：Vite 只加载 web/ 目录下的 env 文件；修改后需重启 dev server。
# 根目录 .env 只影响 server 与 Node 脚本，不会传给浏览器。

# 模型下载源（本地模型模式下仅在模型缺失时作为兜底）。
# 默认官方 https://huggingface.co/ ；国内网络可改为 https://hf-mirror.com/
VITE_HF_ENDPOINT=https://huggingface.co/

# ONNX Runtime wasm 资源目录：使用 npm run prepare:assets 生成到 web/public/ort（同源）。
# 如需使用 CDN，可改为完整 CDN 前缀；留空会回退 /ort/。
VITE_ORT_WASM_PATH=/ort/

# 使用本地模型目录（1=启用；需先执行 npm run prepare:assets）。
# 设为 0 或删除该行：模型从 VITE_HF_ENDPOINT 在线下载（仍需联网）。
VITE_LOCAL_MODELS=1

# 本地模型路径，默认 /models/（即 web/public/models）。
VITE_LOCAL_MODEL_PATH=/models/
